# Supabase connection string (Project Settings -> Database -> Connection string -> "Session pooler")
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# Password you type to open /admin
ADMIN_PASSWORD=change-me
# Any long random string; keeps admin logins valid across restarts
SESSION_SECRET=replace-with-a-long-random-string
# Address the QR code and flyer point to (optional)
PUBLIC_URL=https://potluck-signup-8oyh.onrender.com/
